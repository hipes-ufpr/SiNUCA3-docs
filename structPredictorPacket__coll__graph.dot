digraph "PredictorPacket"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="PredictorPacket",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Message exchanged between components and branch predictors such as BTBs, RASs, etc...."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">instruction</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">requestQuery</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node2 [id="Node000002",label="InstructionPacket",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structInstructionPacket.html",tooltip="Carries the information regarding an executed instruction."];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">staticInfo</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node3 [id="Node000003",label="StaticInstructionInfo",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structStaticInstructionInfo.html",tooltip="Stores details of an instruction. These details are static and wont change during program execution."];
  Node4 -> Node2 [id="edge3_Node000002_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">dynamicInfo</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node4 [id="Node000004",label="DynamicInstructionInfo",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structDynamicInstructionInfo.html",tooltip="Stores details of an instruction. These details are dynamic and will vary during program execution."];
}
